POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_32_CHAR_SECRET
POSTGRES_DB=enchentes
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
ENVIRONMENT=development
# Em producao, liste apenas os frontends externos separados por virgula.
# O painel servido pela propria API funciona com a lista vazia.
CORS_ORIGINS=
API_KEYS=CHANGE_ME_INTERNAL_API_KEY
TENANT_API_KEYS=CHANGE_ME_KEY:ADMIN:tenant_id
WEBHOOK_SECRET_KEY=CHANGE_ME_FERNET_BASE64_32_BYTE_KEY
DEFAULT_RATE_LIMIT_PER_MINUTE=60
# Opcional: datas ISO 8601 com fuso, ex.: 2026-10-20T22:00:00-03:00
MANUTENCAO_INICIO=
MANUTENCAO_FIM=
MANUTENCAO_AVISO=
DADOS_PUBLICOS_INTERVALO_HORAS=24
WEBHOOK_ALERTA_DADOS=
